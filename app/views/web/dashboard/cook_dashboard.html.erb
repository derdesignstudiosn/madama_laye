<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
  <div class="card p-6 md:p-8">
    <div class="flex items-center gap-3">
      <div class="bg-muted p-3 rounded-full"><i class="fas fa-clock text-primary text-xl"></i></div>
      <div>
        <p class="heading-2"><%= @pending_orders %></p>
        <p class="text-gray-500 text-sm">En attente</p>
      </div>
    </div>
  </div>
  <div class="card p-6 md:p-8">
    <div class="flex items-center gap-3">
      <div class="bg-blue-100 p-3 rounded-full"><i class="fas fa-spinner text-blue-600 text-xl"></i></div>
      <div>
        <p class="heading-2"><%= @in_progress_orders %></p>
        <p class="text-gray-500 text-sm">En cours</p>
      </div>
    </div>
  </div>
  <div class="card p-6 md:p-8">
    <div class="flex items-center gap-3">
      <div class="bg-green-100 p-3 rounded-full"><i class="fas fa-utensils text-green-600 text-xl"></i></div>
      <div>
        <p class="heading-2"><%= @today_meals %></p>
        <p class="text-gray-500 text-sm">Plats dispo</p>
      </div>
    </div>
  </div>
  <div class="card p-6 md:p-8">
    <div class="flex items-center gap-3">
      <div class="bg-yellow-100 p-3 rounded-full"><i class="fas fa-truck text-yellow-600 text-xl"></i></div>
      <div>
        <p class="heading-2"><%= @today_orders.count %></p>
        <p class="text-gray-500 text-sm">Commandes jour</p>
      </div>
    </div>
  </div>
</div>

<div class="grid md:grid-cols-2 gap-6">
  <div class="card">
    <div class="card-header">
      <h2 class="heading-3"><i class="fas fa-shopping-cart text-primary"></i> Commandes du jour</h2>
    </div>
    <div class="card-body">
      <% if @today_orders.any? %>
        <div class="space-y-3">
          <% @today_orders.each do |order| %>
            <div class="border rounded-lg p-3 flex justify-between items-center">
              <div>
                <p class="font-medium"><%= order.customer.full_name %></p>
                <p class="text-gray-500 text-sm"><%= order.order_items.count %> article(s) · <%= number_to_currency(order.total_amount, unit: "CFA", format: "%n %u") %></p>
                <span class="badge <%= 'badge-secondary' if order.pending? %><%= 'badge-primary' if order.accepted? %><%= 'badge-secondary' if order.in_delivery? %>"><%= order.status %></span>
              </div>
              <div class="flex gap-2">
                <% if order.pending? %>
                  <a href="/orders/<%= order.id %>/accept" class="btn btn-sm" style="background-color:#16a34a;color:white;border:none">
                    <i class="fas fa-check"></i>
                  </a>
                <% elsif order.accepted? %>
                  <a href="/orders/<%= order.id %>/assign" class="btn btn-sm" style="background-color:#9333ea;color:white;border:none">
                    <i class="fas fa-truck"></i>
                  </a>
                <% end %>
                <a href="/orders/<%= order.id %>" class="btn btn-secondary btn-sm">
                  <i class="fas fa-eye"></i>
                </a>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-4"><i class="fas fa-inbox"></i> Aucune commande aujourd'hui</p>
      <% end %>
    </div>
  </div>

  <div>
    <div class="card mb-6">
      <div class="card-header">
        <h2 class="heading-3"><i class="fas fa-calendar-week text-primary"></i> Actions rapides</h2>
      </div>
      <div class="card-body space-y-3">
        <a href="/meals/new" class="block bg-muted border border-border rounded-lg p-3 hover:bg-fog">
          <i class="fas fa-plus-circle text-primary"></i> Ajouter un plat de la semaine
        </a>
        <a href="/daily_products/new" class="block bg-muted border border-border rounded-lg p-3 hover:bg-fog">
          <i class="fas fa-box-open text-primary"></i> Poster un produit journalier
        </a>
        <a href="/orders" class="block bg-muted border border-border rounded-lg p-3 hover:bg-muted">
          <i class="fas fa-list text-gray-400"></i> Voir toutes les commandes
        </a>
        <a href="/drivers" class="block bg-muted border border-border rounded-lg p-3 hover:bg-muted">
          <i class="fas fa-truck text-gray-400"></i> Gérer mes livreurs
        </a>
      </div>
    </div>
  </div>
</div>
