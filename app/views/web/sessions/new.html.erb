<div class="max-w-md mx-auto mt-10">

  <div class="text-center">
    <div class="w-16 h-16 mx-auto bg-primary text-white rounded-3xl flex items-center justify-center text-2xl shadow-lg">
      <i class="fas fa-utensils"></i>
    </div>
    <h1 class="mt-5 heading-2">Bienvenue sur <span class="text-primary">Madame Laye</span></h1>
    <p class="text-sm text-gray-500 mt-1">Connectez-vous à votre espace</p>
  </div>

  <div class="card overflow-hidden mt-8">
    <div class="h-1.5 bg-primary"></div>
    <div class="card-body">
      <form method="post" action="/login" class="space-y-4">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <div>
          <label class="label"><i class="fas fa-mobile-alt text-primary mr-1"></i> Numéro de téléphone</label>
          <input type="tel" name="phone_number" required placeholder="221771234567" class="input">
        </div>
        <div>
          <label class="label"><i class="fas fa-lock text-primary mr-1"></i> Mot de passe</label>
          <input type="password" name="password" required class="input">
        </div>
        <button type="submit" class="btn btn-primary w-full btn-lg">
          <i class="fas fa-sign-in-alt"></i> Se connecter
        </button>
      </form>
    </div>
  </div>

  <p class="text-center text-gray-500 text-sm mt-6">
    Pas encore de compte ? <a href="/signup" class="text-primary font-semibold hover:underline">S'inscrire</a>
  </p>
</div>