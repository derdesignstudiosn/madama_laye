<div class="max-w-lg mx-auto card p-6 md:p-8">
  <div class="card-header flex items-center justify-between">
    <h1 class="heading-2"><i class="fas fa-truck text-primary"></i> Mes livreurs</h1>
    <a href="/drivers/new" class="btn btn-sm" style="background-color:#9333ea;color:white;border:none">
      <i class="fas fa-plus"></i> Ajouter
    </a>
  </div>
  <div class="card-body">
    <% if @drivers.any? %>
      <div class="space-y-3">
        <% @drivers.each do |d| %>
          <div class="border rounded-lg p-4 flex items-center justify-between">
            <div>
              <p class="font-medium"><%= d.full_name %></p>
              <p class="text-sm text-gray-500"><%= d.phone_number %></p>
            </div>
            <a href="/drivers/<%= d.id %>/remove" class="btn btn-sm" style="background-color:#dc2626;color:white;border:none"
               data-confirm="Retirer <%= d.full_name %> de votre liste ?">
              <i class="fas fa-trash"></i>
            </a>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8 text-gray-500">
        <i class="fas fa-truck fa-3x mb-3"></i>
        <p>Vous n'avez pas encore de livreur</p>
        <a href="/drivers/new" class="btn mt-4" style="background-color:#9333ea;color:white;border:none">
          <i class="fas fa-plus"></i> Ajouter un livreur
        </a>
      </div>
    <% end %>
  </div>
</div>
