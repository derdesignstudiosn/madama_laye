<div class="max-w-lg mx-auto card p-6 md:p-8">
  <div class="card-header">
    <h1 class="heading-2"><i class="fas fa-truck text-primary"></i> Assigner un livreur</h1>
  </div>
  <div class="card-body space-y-4">
    <div class="bg-muted p-4 rounded-lg">
      <p class="text-gray-500 text-sm">Commande #<%= @order.id %></p>
      <p class="font-medium"><%= @order.customer.full_name %></p>
      <p class="text-sm"><%= @order.delivery_address %></p>
    </div>

    <% if @my_drivers.any? %>
      <div class="mb-4">
        <p class="text-sm font-medium text-gray-500 mb-2">Mes livreurs</p>
        <form action="/orders/<%= @order.id %>/assign_driver" method="post" class="space-y-2">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
          <select name="driver_id" required class="select">
            <% @my_drivers.each do |d| %>
              <option value="<%= d.id %>"><%= d.full_name %> — <%= d.phone_number %></option>
            <% end %>
          </select>
          <button type="submit" class="btn w-full" style="background-color:#9333ea;color:white;border:none">
            <i class="fas fa-check"></i> Assigner
          </button>
        </form>
      </div>
    <% end %>

    <details class="text-sm">
      <summary class="cursor-pointer text-primary font-medium">Tous les livreurs disponibles</summary>
      <form action="/orders/<%= @order.id %>/assign_driver" method="post" class="space-y-2 mt-2">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <select name="driver_id" required class="select">
          <% @all_drivers.each do |d| %>
            <option value="<%= d.id %>"><%= d.full_name %> — <%= d.phone_number %></option>
          <% end %>
        </select>
        <button type="submit" class="btn w-full" style="background-color:#9333ea;color:white;border:none">
          <i class="fas fa-check"></i> Assigner
        </button>
      </form>
    </details>
  </div>
</div>
